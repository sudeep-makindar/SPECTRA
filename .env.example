# ──────────────────────────────────────────────────────────────────────
# Spectra — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy to .env and edit. All are optional — Spectra works fully offline.

# Server
SPECTRA_SERVER_PORT=8000
SPECTRA_SERVER_LOG_LEVEL=info

# Device (auto-detected, override only if needed)
# PYTORCH_ENABLE_MPS_FALLBACK=1

# AI co-pilot (incident briefings, Ask SPECTRA, shift handover).
# Any OpenAI-compatible provider. Only signal metadata is sent; video/audio stay local.
# Without a key, SPECTRA uses offline templates.
# Several may be listed, best first: if one is rate-limited or down,
# the next takes over automatically.  groq | openrouter | xai | gemini | ollama
LLM_PROVIDER=groq,openrouter
# GROQ_API_KEY=gsk_...       # free: https://console.groq.com/keys
# XAI_API_KEY=xai-...        # Grok: https://console.x.ai
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...
# Per-provider model override, e.g. OPENROUTER_MODEL / GROQ_MODEL
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Telegram alerts (needs internet). Create a bot with @BotFather, put its token
# here, add the bot to your group, then pick the group in the dashboard:
# Devices → Alerts on Telegram → Find my group.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=          # optional; the dashboard sets this for you

# Simulation mode (clearly labeled in UI)
# SPECTRA_SIM_MODE=true

# Debug
# SPECTRA_DEBUG=true
