# ──────────────────────────────────────────────────────────────────────
# Spectra — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy to .env and edit. All are optional — Spectra works fully offline.

# Server
SPECTRA_SERVER_PORT=8000
SPECTRA_SERVER_LOG_LEVEL=info

# Device (auto-detected, override only if needed)
# PYTORCH_ENABLE_MPS_FALLBACK=1

# Claude incident co-pilot (briefings, Ask SPECTRA, shift handover).
# Only structured signal metadata is sent; video/audio never leave the machine.
# Without a key, SPECTRA falls back to offline templates.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5

# Simulation mode (clearly labeled in UI)
# SPECTRA_SIM_MODE=true

# Debug
# SPECTRA_DEBUG=true
